+        v-model:state="componentState"
+        h-full w-full
+        :model-src="stageModelSelectedUrl"
+        :cursor-position="cursorPosition"
+        :idle-animation="animations.idleLoop.toString()"
+        :enable-orbit-controls="windowMode === 'standard'"
+        :paused="prefersReducedMotion"
+        :environment-mode="windowMode === 'compact' ? 'off' : undefined"
+        @model-loading="runtime.notifyModelLoading('vrm', stageModelSelected)"
+        @model-loaded="notifyModelLoaded"
+        @frame-presented="runtime.notifyPresentedFrame()"
+        @error="console.error"
+      />
+    </div>
+  </CompanionDesktopClient>
+</template>
+
+<style scoped>
+.avatar-interaction-surface {
+  height: 100%;
+  width: 100%;
+}
+
+.compact-drag-surface {
+  -webkit-app-region: drag;
+}
+</style>
