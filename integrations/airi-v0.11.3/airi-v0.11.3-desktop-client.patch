@@ -0,0 +1,59 @@
+export interface CompanionWindowProfile {
+  width: number
+  height: number
+  minWidth?: number
+  minHeight?: number
+  transparent: boolean
+  hasShadow: boolean
+  alwaysOnTop: boolean
+}
+
+export function resolveCompanionWindowProfile(enabled: boolean): CompanionWindowProfile {
+  return enabled
+    ? {
+        width: 1180,
+        height: 760,
+        minWidth: 920,
+        minHeight: 640,
+        transparent: true,
+        hasShadow: true,
+        alwaysOnTop: false,
+      }
+    : {
+        width: 450,
+        height: 600,
+        transparent: true,
+        hasShadow: false,
+        alwaysOnTop: true,
+      }
+}
+
+export function shouldPersistCompanionBounds(
+  enabled: boolean,
+  mode: 'standard' | 'compact',
+): boolean {
+  return !enabled || mode === 'standard'
+}
+
+/**
+ * Creates the companion close-to-tray transition.
+ *
+ * Repeated close events share one in-flight stop request so microphone release
+ * completes before the window is hidden and the transition cannot re-enter.
+ */
+export function createCompanionCloseToTrayHandler(params: {
+  stopVoice: () => Promise<unknown>
+  hideWindow: () => void
+}): () => Promise<void> {
+  let transition: Promise<void> | undefined
+
+  return () => {
+    transition ??= params.stopVoice()
+      .catch(() => undefined)
+      .then(() => params.hideWindow())
+      .finally(() => {
+        transition = undefined
+      })
+    return transition
+  }
+}
