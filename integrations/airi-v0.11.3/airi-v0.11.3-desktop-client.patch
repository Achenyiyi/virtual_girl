+import { describe, expect, it, vi } from 'vitest'
+
+import { createCompanionEventaElectronApi } from './companion-eventa'
+
+function envelope(type: string) {
+  const correlatedId = type.match(/-(\w{16})$/u)?.[1]
+  return {
+    id: 'event-id',
+    type,
+    payload: {
+      body: type.includes(':invoke:') || type.endsWith('-send-abort')
+        ? { invokeId: correlatedId ?? 'Abcdef0123456789' }
+        : {},
+    },
+  }
+}
+
+function createTransport() {
+  const listeners = new Map<string, (event: Electron.IpcRendererEvent, ...args: unknown[]) => void>()
+  const send = vi.fn()
+  const on = vi.fn((channel: string, listener: (event: Electron.IpcRendererEvent, ...args: unknown[]) => void) => {
+    listeners.set(channel, listener)
+  })
+  const removeListener = vi.fn((channel: string) => {
+    listeners.delete(channel)
+  })
+  return { listeners, transport: { send, on, removeListener } }
+}
+
+describe('companion desktop Eventa preload boundary', () => {
+  it('passes exact avatar, model, and window Eventa ids', () => {
+    const { transport } = createTransport()
+    const api = createCompanionEventaElectronApi(transport)
+
+    api.ipcRenderer.send('eventa-message', envelope('eventa:invoke:electron:avatar-bridge:managed-model:get-send'))
+    api.ipcRenderer.send('eventa-message', envelope('eventa:invoke:electron:avatar-bridge:renderer-receive-Abcdef0123456789'))
+    api.ipcRenderer.send('eventa-message', envelope('eventa:invoke:electron:window:resize-send'))
+
+    expect(transport.send).toHaveBeenCalledTimes(3)
+  })
+
+  it('rejects arbitrary channels and malformed envelopes', () => {
+    const { transport } = createTransport()
+    const api = createCompanionEventaElectronApi(transport)
+
+    expect(() => api.ipcRenderer.send('companion-control:request', envelope('eventa:invoke:electron:window:resize-send'))).toThrow('channel is unavailable')
+    expect(() => api.ipcRenderer.send('eventa-message', { id: 'event-id', payload: {} })).toThrow('method is unavailable')
+    expect(() => api.ipcRenderer.send('eventa-message', {
+      id: 'event-id',
+      type: 'eventa:invoke:electron:window:resize-send',
+      payload: { body: {} },
+    })).toThrow('method is unavailable')
+    expect(() => api.ipcRenderer.on('arbitrary-channel', vi.fn())).toThrow('channel is unavailable')
+    expect(transport.send).not.toHaveBeenCalled()
+  })
+
+  it('rejects MCP, plugin, onboarding, and application quit Eventa ids', () => {
+    const { transport } = createTransport()
+    const api = createCompanionEventaElectronApi(transport)
+
+    expect(() => api.ipcRenderer.send('eventa-message', envelope('eventa:invoke:electron:mcp:list-tools-send'))).toThrow('method is unavailable')
+    expect(() => api.ipcRenderer.send('eventa-message', envelope('eventa:invoke:electron:plugin:host:list-send'))).toThrow('method is unavailable')
+    expect(() => api.ipcRenderer.send('eventa-message', envelope('eventa:invoke:electron:windows:onboarding:open-send'))).toThrow('method is unavailable')
+    expect(() => api.ipcRenderer.send('eventa-message', envelope('eventa:invoke:electron:app:quit-send'))).toThrow('method is unavailable')
+  })
+
+  it('filters pushed Eventa payloads before invoking renderer listeners', () => {
+    const { listeners, transport } = createTransport()
+    const api = createCompanionEventaElectronApi(transport)
+    const listener = vi.fn()
+    api.ipcRenderer.on('eventa-push', listener)
+
+    const push = listeners.get('eventa-push')!
+    push({} as Electron.IpcRendererEvent, envelope('eventa:event:electron:window:lifecycle-changed'))
+    push({} as Electron.IpcRendererEvent, envelope('eventa:event:electron:plugin:tools-changed'))
+    push({} as Electron.IpcRendererEvent, { id: 'bad', type: 42, payload: {} })
+
+    expect(listener).toHaveBeenCalledTimes(1)
+  })
+
+  it('accepts only exact correlated response bases', () => {
+    const { listeners, transport } = createTransport()
+    const api = createCompanionEventaElectronApi(transport)
+    const listener = vi.fn()
+    api.ipcRenderer.on('eventa-message', listener)
+
+    const receive = listeners.get('eventa-message')!
+    receive({} as Electron.IpcRendererEvent, envelope('eventa:invoke:electron:avatar-bridge:managed-model:get-receive-Abcdef0123456789'))
+    receive({} as Electron.IpcRendererEvent, envelope('eventa:invoke:electron:avatar-bridge:managed-model:get-receive-extra-Abcdef0123456789'))
+
+    expect(listener).toHaveBeenCalledTimes(1)
+  })
+
+  it('keeps correlated response bases directional', () => {
+    const { listeners, transport } = createTransport()
+    const api = createCompanionEventaElectronApi(transport)
+    const listener = vi.fn()
+    api.ipcRenderer.on('eventa-message', listener)
+
+    expect(() => api.ipcRenderer.send(
+      'eventa-message',
+      envelope('eventa:invoke:electron:avatar-bridge:managed-model:get-receive-Abcdef0123456789'),
+    )).toThrow('method is unavailable')
+
+    const receive = listeners.get('eventa-message')!
+    receive(
+      {} as Electron.IpcRendererEvent,
+      envelope('eventa:invoke:electron:avatar-bridge:renderer-receive-Abcdef0123456789'),
+    )
+
+    expect(listener).not.toHaveBeenCalled()
+  })
+
+  it('rejects mismatched correlation and malformed abort invoke ids', () => {
+    const { listeners, transport } = createTransport()
+    const api = createCompanionEventaElectronApi(transport)
+    const listener = vi.fn()
+    api.ipcRenderer.on('eventa-message', listener)
+
+    expect(() => api.ipcRenderer.send('eventa-message', {
+      ...envelope('eventa:invoke:electron:avatar-bridge:renderer-receive-Abcdef0123456789'),
+      payload: { body: { invokeId: 'Different1234567' } },
+    })).toThrow('method is unavailable')
+    expect(() => api.ipcRenderer.send('eventa-message', {
+      ...envelope('eventa:invoke:electron:window:resize-send-abort'),
+      payload: { body: { invokeId: '../bad' } },
+    })).toThrow('method is unavailable')
+
+    const receive = listeners.get('eventa-message')!
+    receive({} as Electron.IpcRendererEvent, {
+      ...envelope('eventa:invoke:electron:window:resize-receive-Abcdef0123456789'),
+      payload: { body: { invokeId: 'Different1234567' } },
+    })
+    expect(listener).not.toHaveBeenCalled()
+  })
+
+  it('replaces Eventa transport errors with a generic renderer-safe value', () => {
+    const { listeners, transport } = createTransport()
+    const api = createCompanionEventaElectronApi(transport)
+    const listener = vi.fn()
+    api.ipcRenderer.on('eventa-error', listener)
+
+    listeners.get('eventa-error')!(
+      {} as Electron.IpcRendererEvent,
+      new Error('C:\\Users\\secret\\token.txt\n    at handler (C:\\app\\main.js:8:3)'),
+    )
+
+    const forwarded = listener.mock.calls[0]?.[1]
+    expect(forwarded).toEqual({ message: 'Companion Desktop Eventa transport failed' })
+    expect(JSON.stringify(forwarded)).not.toContain('secret')
+    expect(JSON.stringify(forwarded)).not.toContain('main.js')
+    expect(JSON.stringify(forwarded)).not.toContain('stack')
+  })
+
+  it('does not expose generic Electron IPC primitives', () => {
+    const { transport } = createTransport()
+    const api = createCompanionEventaElectronApi(transport)
+    const renderer = api.ipcRenderer as unknown as Record<string, unknown>
+
+    expect(Object.keys(renderer).sort()).toEqual(['on', 'removeListener', 'send'])
+    expect(renderer.invoke).toBeUndefined()
+    expect(renderer.sendSync).toBeUndefined()
+    expect(renderer.postMessage).toBeUndefined()
+    expect(renderer.sendTo).toBeUndefined()
+    expect(renderer.sendToHost).toBeUndefined()
+    expect(renderer.removeAllListeners).toBeUndefined()
+  })
+})
