+}[snapshot.value.phase || 'starting'] || '正在连接'))
+const phaseTone = computed(() => snapshot.value.phase === 'ready'
+  ? 'ready'
+  : snapshot.value.phase === 'degraded' || snapshot.value.phase === 'setup_required'
+    ? 'warning'
+    : snapshot.value.phase === 'error' ? 'error' : 'neutral')
+
+async function refreshSnapshot(): Promise<void> {
+  try {
+    snapshot.value = await props.api.runtimeSnapshot() as RuntimeSnapshot
+    connected.value = true
+  }
+  catch {
+    connected.value = false
+    snapshot.value = {
+      phase: 'error',
+      error: { message: '桌面宿主连接已断开。', retryable: true },
+    }
+  }
+  finally {
+    loadingSnapshot.value = false
+  }
+}
+
+function turnById(turnId: string): TurnView | undefined {
+  return turns.value.find(turn => turn.turn_id === turnId)
+}
+
+function handleEvent(event: CompanionControlEvent): void {
+  const payload = event.payload
+  if (event.event === 'runtime.snapshot') {
+    snapshot.value = payload as RuntimeSnapshot
+    connected.value = snapshot.value.error?.code !== 'control_disconnected'
+    return
+  }
+  if (event.event === 'voice.state.changed') {
+    snapshot.value = { ...snapshot.value, voice: payload as RuntimeSnapshot['voice'] }
+    return
+  }
+  if (event.event === 'emotion.changed') {
+    snapshot.value = { ...snapshot.value, emotion: payload as RuntimeSnapshot['emotion'] }
+    return
+  }
+  const turnId = typeof payload.turn_id === 'string' ? payload.turn_id : ''
+  if (!turnId)
+    return
+  if (event.event === 'conversation.turn.started') {
+    snapshot.value = { ...snapshot.value, active_turn: { turn_id: turnId } }
+    if (!turnById(turnId)) {
+      turns.value.push({
+        turn_id: turnId,
+        user_text: typeof payload.user_text === 'string' ? payload.user_text : '',
+        companion_text: '',
+        status: 'streaming',
+      })
+    }
+  }
+  else if (event.event === 'conversation.response.delta') {
+    const turn = turnById(turnId)
+    if (turn && typeof payload.text === 'string')
+      turn.companion_text += payload.text
+  }
+  else if (event.event === 'conversation.turn.completed') {
+    const turn = turnById(turnId)
+    if (turn) {
+      if (typeof payload.user_text === 'string')
+        turn.user_text = payload.user_text
+      turn.companion_text = typeof payload.companion_text === 'string' ? payload.companion_text : ''
+      turn.status = 'completed'
+    }
+    if (activeTurnId.value === turnId)
+      snapshot.value = { ...snapshot.value, active_turn: null }
+  }
+  else if (event.event === 'conversation.turn.failed') {
+    const turn = turnById(turnId)
+    if (turn) {
+      turn.companion_text = ''
+      turn.status = 'failed'
+      turn.error = payload.error_type === 'cancelled' ? '已取消' : '回复失败，请重试'
+    }
+    if (activeTurnId.value === turnId)
+      snapshot.value = { ...snapshot.value, active_turn: null }
+  }
+  void nextTick(() => listEnd.value?.scrollIntoView({ behavior: motionQuery.matches ? 'auto' : 'smooth', block: 'end' }))
+}
+
+async function send(): Promise<void> {
+  const value = text.value.trim()
+  if (!canSend.value || value.length > 8000)
+    return
+  actionError.value = ''
+  busy.value = true
+  try {
+    await props.api.send({ text: value, speak: speakText.value })
+    text.value = ''
+  }
+  catch {
+    actionError.value = '消息未发送，请检查运行时状态后重试。'
+  }
+  finally {
+    busy.value = false
+  }
+}
+
+async function cancelActive(): Promise<void> {
+  if (!activeTurnId.value)
+    return
+  actionError.value = ''
+  try {
+    await props.api.cancel({ turn_id: activeTurnId.value })
+  }
+  catch {
+    actionError.value = '当前回复未能取消，请稍后重试。'
+  }
+}
+
+async function toggleVoice(): Promise<void> {
+  if (!voiceInputAvailable.value)
+    return
+  actionError.value = ''
+  try {
+    if (microphoneOn.value)
+      await props.api.stopVoice()
+    else
+      await props.api.startVoice()
+  }
+  catch {
+    actionError.value = microphoneOn.value
+      ? '麦克风未能停止，请从托盘退出以确保设备释放。'
+      : '默认麦克风或语音服务暂时不可用。'
+  }
+}
+
+async function loadSessions(): Promise<void> {
+  panelError.value = ''
+  try {
+    const result = await props.api.listSessions({ limit: 20 }) as { sessions?: SessionView[] }
+    sessions.value = result.sessions || []
+  }
+  catch {
+    sessions.value = []
+    panelError.value = '最近会话暂时无法读取。'
+  }
+}
+
+async function openSession(session: SessionView): Promise<void> {
+  historyLoading.value = true
+  selectedSession.value = session
+  panelError.value = ''
+  try {
+    const result = await props.api.history({ session_id: session.session_id, limit: 100 }) as { turns?: TurnView[] }
+    historyTurns.value = (result.turns || []).map(turn => ({ ...turn, status: 'completed' }))
+  }
+  catch {
+    historyTurns.value = []
+    panelError.value = '该会话暂时无法读取。'
+  }
+  finally {
+    historyLoading.value = false
+  }
+}
+
+async function setView(next: typeof view.value): Promise<void> {
+  view.value = next
+  selectedSession.value = null
+  panelError.value = ''
+  if (next === 'history')
+    await loadSessions()
+}
+
+const tabViews = ['conversation', 'history', 'settings'] as const
+
+function handleTabKeydown(event: KeyboardEvent): void {
+  const tabs = Array.from(
+    (event.currentTarget as HTMLElement).querySelectorAll<HTMLButtonElement>('[role="tab"]'),
+  )
+  const currentIndex = tabs.indexOf(document.activeElement as HTMLButtonElement)
+  if (currentIndex < 0)
+    return
+  let nextIndex = currentIndex
+  if (event.key === 'ArrowRight')
+    nextIndex = (currentIndex + 1) % tabs.length
+  else if (event.key === 'ArrowLeft')
+    nextIndex = (currentIndex - 1 + tabs.length) % tabs.length
+  else if (event.key === 'Home')
+    nextIndex = 0
+  else if (event.key === 'End')
+    nextIndex = tabs.length - 1
+  else
+    return
+  event.preventDefault()
+  void setView(tabViews[nextIndex])
+  tabs[nextIndex]?.focus()
+}
+
+async function retryRuntime(): Promise<void> {
+  panelError.value = ''
+  try {
+    await props.api.runtimeRetry()
+  }
+  catch {
+    panelError.value = connected.value
+      ? '运行时重试未能启动，请稍后再试。'
+      : '桌面宿主连接已断开，请从托盘退出后重新启动。'
+  }
+}
+
+function getEventTrigger(event?: Event): HTMLElement | null {
+  if (event?.currentTarget instanceof HTMLElement)
+    return event.currentTarget
+  return document.activeElement instanceof HTMLElement ? document.activeElement : null
+}
+
+const focusableSelector = [
+  'a[href]',
+  'button:not([disabled])',
+  'input:not([disabled])',
+  'select:not([disabled])',
+  'textarea:not([disabled])',
+  '[tabindex]:not([tabindex="-1"])',
+].join(',')
+
+function trapDialogFocus(event: KeyboardEvent, container?: HTMLElement): void {
+  if (event.key !== 'Tab' || !container)
+    return
+  const focusable = Array.from(container.querySelectorAll<HTMLElement>(focusableSelector))
+  if (focusable.length === 0) {
+    event.preventDefault()
+    container.focus()
+    return
+  }
+  const activeIndex = document.activeElement instanceof HTMLElement
+    ? focusable.indexOf(document.activeElement)
+    : -1
+  if (event.shiftKey && activeIndex <= 0) {
+    event.preventDefault()
+    focusable.at(-1)?.focus()
+  }
+  else if (!event.shiftKey && (activeIndex === -1 || activeIndex === focusable.length - 1)) {
+    event.preventDefault()
+    focusable[0]?.focus()
+  }
+}
+
+function handleBackgroundFocus(event: FocusEvent): void {
+  if (!(event.target instanceof Node))
+    return
+  if (credentialKind.value && !credentialDialog.value?.contains(event.target)) {
+    event.stopPropagation()
+    credentialInput.value?.focus()
+    return
+  }
+  if (compactOverlay.value && !compactOverlayDialog.value?.contains(event.target)) {
+    event.stopPropagation()
+    compactOverlayClose.value?.focus()
+  }
+}
+
+async function openCredential(kind: CompanionCredentialKind, event?: Event): Promise<void> {
+  credentialTrigger.value = getEventTrigger(event)
+  credentialKind.value = kind
+  credentialValue.value = ''
+  credentialError.value = ''
+  credentialOverwrite.value = snapshot.value.credentials?.[kind] === 'windows_credential'
+  await nextTick()
+  credentialInput.value?.focus()
+}
+
+async function closeCredential(): Promise<void> {
+  const trigger = credentialTrigger.value
+  credentialKind.value = null
+  credentialValue.value = ''
+  credentialError.value = ''
+  credentialOverwrite.value = false
+  credentialTrigger.value = null
+  await nextTick()
+  if (trigger?.isConnected)
+    trigger.focus()
+}
+
+function handleCredentialKeydown(event: KeyboardEvent): void {
+  if (event.key === 'Escape') {
+    event.preventDefault()
+    event.stopPropagation()
+    void closeCredential()
+    return
+  }
+  trapDialogFocus(event, credentialDialog.value)
+}
+
+async function saveCredential(): Promise<void> {
+  if (!credentialKind.value || !credentialValue.value.trim())
+    return
+  credentialError.value = ''
+  credentialSaving.value = true
+  try {
+    await props.api.setCredential({
+      kind: credentialKind.value,
+      value: credentialValue.value,
+      overwrite: credentialOverwrite.value,
+    })
+    snapshot.value = {
+      ...snapshot.value,
+      credentials: {
+        llm: snapshot.value.credentials?.llm || 'missing',
+        tts: snapshot.value.credentials?.tts || 'missing',
+        [credentialKind.value]: 'windows_credential',
+      },
+    }
+    await closeCredential()
+  }
+  catch {
+    credentialError.value = '凭据未写入。请确认是否需要明确覆盖，然后重试。'
+  }
+  finally {
+    credentialSaving.value = false
+  }
+}
+
+async function setMode(next: CompanionWindowMode): Promise<void> {
+  mode.value = next
+  emit('windowModeChanged', next)
+  if (next === 'standard') {
+    compactOverlay.value = null
+    compactOverlayTrigger.value = null
+  }
+  await props.api.setWindowMode(next)
+}
+
+async function openCompactOverlay(next: 'history' | 'settings', event?: Event): Promise<void> {
+  compactOverlayTrigger.value = getEventTrigger(event)
+  compactOverlay.value = next
+  selectedSession.value = null
+  panelError.value = ''
+  await nextTick()
+  compactOverlayClose.value?.focus()
+  if (next === 'history')
+    await loadSessions()
+}
+
+async function closeCompactOverlay(): Promise<void> {
+  const trigger = compactOverlayTrigger.value
+  compactOverlay.value = null
+  compactOverlayTrigger.value = null
+  await nextTick()
+  if (trigger?.isConnected)
+    trigger.focus()
+}
+
+function handleCompactOverlayKeydown(event: KeyboardEvent): void {
+  if (event.key === 'Escape') {
+    event.preventDefault()
+    event.stopPropagation()
+    void closeCompactOverlay()
+    return
+  }
+  trapDialogFocus(event, compactOverlayDialog.value)
+}
+
+function hideToTray(): void {
+  window.close()
+}
+
+function syncSystemTheme(event: MediaQueryListEvent): void {
+  systemDark.value = event.matches
+}
+
+watch(resolvedTheme, (value) => {
+  document.documentElement.classList.toggle('dark', value === 'dark')
+  document.documentElement.style.colorScheme = value
+}, { immediate: true })
+
+onMounted(async () => {
+  systemThemeQuery.addEventListener('change', syncSystemTheme)
+  document.addEventListener('focusin', handleBackgroundFocus)
+  unsubscribe = props.api.subscribe(handleEvent)
+  await refreshSnapshot()
+})
+
+onUnmounted(() => {
+  systemThemeQuery.removeEventListener('change', syncSystemTheme)
+  document.removeEventListener('focusin', handleBackgroundFocus)
+  credentialValue.value = ''
+  credentialTrigger.value = null
+  compactOverlayTrigger.value = null
+  unsubscribe?.()
+})
+</script>
