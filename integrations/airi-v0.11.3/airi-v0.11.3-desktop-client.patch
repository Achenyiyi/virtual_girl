+async function applyAvatarExpression(expressionId: string, intensity: number, _durationMs: number) {
+  if (!scene.value)
+    throw new Error('avatar stage is unavailable')
+  scene.value.setExpression(expressionId, intensity)
+}
+
+async function applyAvatarEmotion(expressionId: string, intensity: number) {
+  if (!scene.value)
+    throw new Error('avatar stage is unavailable')
+  scene.value.setEmotion(expressionId, intensity)
+}
+
+async function applyAvatarGesture(gestureId: string, intensity: number) {
+  if (!scene.value)
+    throw new Error('avatar stage is unavailable')
+  await scene.value.playAvatarGesture(gestureId, intensity)
+}
+
+async function applyAvatarState(state: AvatarStateSnapshot) {
+  await applyAvatarEmotion(state.expression.expression_id, state.expression.intensity)
+  if (!scene.value)
+    throw new Error('avatar stage is unavailable')
+  scene.value.setLipSync(state.expression.mouth_open)
+  if (state.pose.gesture_id)
+    await applyAvatarGesture(state.pose.gesture_id, state.pose.gesture_intensity)
+}
+
+async function applyAvatarProactiveLevel(_level: number) {
+  if (!scene.value)
+    throw new Error('avatar stage is unavailable')
+}
+
