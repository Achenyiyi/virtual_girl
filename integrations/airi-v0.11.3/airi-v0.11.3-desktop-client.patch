@@ -0,0 +1,288 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+import {
+  COMPANION_CONTROL_IPC_EVENT,
+  COMPANION_CONTROL_IPC_REQUEST,
+  COMPANION_CONTROL_IPC_WINDOW_MODE,
+  COMPANION_CONTROL_PROTOCOL,
+  COMPANION_CONTROL_VERSION,
+  consumeCompanionControlEnvironment,
+  createCompanionConnectionErrorEvent,
+} from '../../../../shared/companion-control'
+import { createCompanionControlClient } from './client'
+
+type CompanionControlRenderer = Parameters<ReturnType<typeof createCompanionControlClient>['installIpc']>[0]
+
+const ipcMainMock = vi.hoisted(() => ({
+  handle: vi.fn(),
+  on: vi.fn(),
+  removeHandler: vi.fn(),
+  removeListener: vi.fn(),
+}))
+
+vi.mock('electron', () => ({
+  ipcMain: ipcMainMock,
+}))
+
+beforeEach(() => {
+  vi.clearAllMocks()
+})
+
+function createRenderer(id: number): CompanionControlRenderer {
+  return {
+    id,
+    isDestroyed: vi.fn(() => false),
+    send: vi.fn(),
+  }
+}
+
+describe('companion control environment', () => {
+  it('remains disabled for ordinary AIRI starts', () => {
+    const environment: NodeJS.ProcessEnv = {}
+
+    expect(consumeCompanionControlEnvironment(environment)).toBeUndefined()
+  })
+
+  it('reads and removes both control secrets from the process environment', () => {
+    const environment: NodeJS.ProcessEnv = {
+      COMPANION_CONTROL_URL: 'ws://127.0.0.1:49152',
+      COMPANION_CONTROL_TOKEN: 'secret-token',
+    }
+
+    const client = consumeCompanionControlEnvironment(environment)
+
+    expect(client).toEqual({ url: 'ws://127.0.0.1:49152', token: 'secret-token' })
+    expect(environment.COMPANION_CONTROL_URL).toBeUndefined()
+    expect(environment.COMPANION_CONTROL_TOKEN).toBeUndefined()
+  })
+
+  it('rejects partial or non-loopback configuration', () => {
+    expect(() => consumeCompanionControlEnvironment({
+      COMPANION_CONTROL_URL: 'ws://127.0.0.1:49152',
+    })).toThrow('environment is invalid')
+    expect(() => consumeCompanionControlEnvironment({
+      COMPANION_CONTROL_URL: 'ws://192.168.1.4:49152',
+      COMPANION_CONTROL_TOKEN: 'secret-token',
+    })).toThrow('environment is invalid')
+  })
+
+  it('creates a sanitized renderer snapshot when the host disconnects', () => {
+    const event = createCompanionConnectionErrorEvent()
+    const serialized = JSON.stringify(event)
+
+    expect(event).toMatchObject({
+      event: 'runtime.snapshot',
+      payload: {
+        phase: 'error',
+        active_turn: null,
+        error: {
+          code: 'control_disconnected',
+          retryable: true,
+        },
+      },
+    })
+    expect(serialized).not.toContain('COMPANION_CONTROL_TOKEN')
+    expect(serialized).not.toContain('stack')
+    expect(serialized).not.toMatch(/[A-Z]:\\/)
+  })
+})
+
+describe('companion control IPC sender boundary', () => {
+  function installIpc() {
+    const client = createCompanionControlClient('ws://127.0.0.1:49152', 'secret-token')
+    const setWindowMode = vi.fn()
+    const webContents = createRenderer(41)
+
+    client.installIpc(webContents, setWindowMode)
+
+    const requestHandler = ipcMainMock.handle.mock.calls.find(([channel]) => channel === COMPANION_CONTROL_IPC_REQUEST)?.[1]
+    const modeHandler = ipcMainMock.on.mock.calls.find(([channel]) => channel === COMPANION_CONTROL_IPC_WINDOW_MODE)?.[1]
+
+    expect(requestHandler).toBeTypeOf('function')
+    expect(modeHandler).toBeTypeOf('function')
+    return { modeHandler, requestHandler, setWindowMode }
+  }
+
+  it('rejects requests from a renderer other than the installed web contents', async () => {
+    const { requestHandler } = installIpc()
+
+    // ROOT CAUSE:
+    //
+    // ipcMain handlers are process-global. Without checking event.sender, any renderer
+    // could call the privileged Control bridge registered for the companion window.
+    await expect(requestHandler(
+      { sender: { id: 42 } },
+      { method: 'runtime.snapshot', params: {} },
+    )).rejects.toThrow('Companion Control renderer is unauthorized')
+  })
+
+  it('accepts window mode changes only from the installed web contents', () => {
+    const { modeHandler, setWindowMode } = installIpc()
+
+    modeHandler({ sender: { id: 42 } }, 'compact')
+    expect(setWindowMode).not.toHaveBeenCalled()
+
+    modeHandler({ sender: { id: 41 } }, 'compact')
+    expect(setWindowMode).toHaveBeenCalledOnce()
+    expect(setWindowMode).toHaveBeenCalledWith('compact')
+  })
+})
+
+describe('companion control event validation', () => {
+  class MockWebSocket {
+    static readonly CONNECTING = 0
+    static readonly OPEN = 1
+    static readonly CLOSING = 2
+
+    readonly sent: string[] = []
+    readyState = MockWebSocket.CONNECTING
+    private readonly listeners = new Map<string, Set<(event: unknown) => void>>()
+
+    addEventListener(type: string, listener: (event: unknown) => void): void {
+      const listeners = this.listeners.get(type) ?? new Set()
+      listeners.add(listener)
+      this.listeners.set(type, listeners)
+    }
+
+    send(message: string): void {
+      this.sent.push(message)
+    }
+
+    close(): void {
+      this.readyState = MockWebSocket.CLOSING
+    }
+
+    emit(type: string, event: unknown = {}): void {
+      for (const listener of this.listeners.get(type) ?? [])
+        listener(event)
+    }
+  }
+
+  it('forwards only known events with monotonic safe sequences and object payloads', async () => {
+    let socket: MockWebSocket | undefined
+    vi.stubGlobal('WebSocket', class extends MockWebSocket {
+      constructor() {
+        super()
+        socket = this
+      }
+    })
+    const client = createCompanionControlClient('ws://127.0.0.1:49152', 'secret-token')
+    const renderer = createRenderer(41)
+    client.installIpc(renderer, vi.fn())
+
+    const connection = client.connect()
+    socket!.readyState = MockWebSocket.OPEN
+    socket!.emit('open')
+    await vi.waitFor(() => expect(socket!.sent).toHaveLength(1))
+    const handshake = JSON.parse(socket!.sent[0]) as { id: string }
+    socket!.emit('message', { data: JSON.stringify({
+      protocol: COMPANION_CONTROL_PROTOCOL,
+      version: COMPANION_CONTROL_VERSION,
+      type: 'response',
+      id: handshake.id,
+      result: {},
+    }) })
+    await connection
+
+    const emitEvent = (event: string, sequence: unknown, payload: unknown) => socket!.emit('message', {
+      data: JSON.stringify({
+        protocol: COMPANION_CONTROL_PROTOCOL,
+        version: COMPANION_CONTROL_VERSION,
+        type: 'event',
+        event,
+        sequence,
+        payload,
+      }),
+    })
+    emitEvent('runtime.snapshot', 3, { phase: 'ready' })
+    emitEvent('plugin.tools.changed', 4, {})
+    emitEvent('emotion.changed', 3, {})
+    emitEvent('emotion.changed', 2, {})
+    emitEvent('emotion.changed', 4.5, {})
+    emitEvent('emotion.changed', 5, [])
+    emitEvent('emotion.changed', 6, { valence: 0.25 })
+
+    expect(renderer.send).toHaveBeenCalledTimes(2)
+    expect(renderer.send).toHaveBeenNthCalledWith(1, COMPANION_CONTROL_IPC_EVENT, {
+      event: 'runtime.snapshot',
+      sequence: 3,
+      payload: { phase: 'ready' },
+    })
+    expect(renderer.send).toHaveBeenNthCalledWith(2, COMPANION_CONTROL_IPC_EVENT, {
+      event: 'emotion.changed',
+      sequence: 6,
+      payload: { valence: 0.25 },
+    })
+  })
+
+  it('rejects and clears pending requests when the client closes', async () => {
+    let socket: MockWebSocket | undefined
+    vi.stubGlobal('WebSocket', class extends MockWebSocket {
+      constructor() {
+        super()
+        socket = this
+      }
+    })
+    const client = createCompanionControlClient('ws://127.0.0.1:49152', 'secret-token')
+    const connection = client.connect()
+    socket!.readyState = MockWebSocket.OPEN
+    socket!.emit('open')
+    await vi.waitFor(() => expect(socket!.sent).toHaveLength(1))
+    const handshake = JSON.parse(socket!.sent[0]) as { id: string }
+    socket!.emit('message', { data: JSON.stringify({
+      protocol: COMPANION_CONTROL_PROTOCOL,
+      version: COMPANION_CONTROL_VERSION,
+      type: 'response',
+      id: handshake.id,
+      result: {},
+    }) })
+    await connection
+
+    const pending = client.request('runtime.snapshot')
+    await vi.waitFor(() => expect(socket!.sent).toHaveLength(2))
+    await client.close()
+
+    await expect(pending).rejects.toThrow('Companion Control closed')
+    expect(socket!.readyState).toBe(MockWebSocket.CLOSING)
+  })
+
+  it('removes timed-out requests so a late response is ignored', async () => {
+    vi.useFakeTimers()
+    let socket: MockWebSocket | undefined
+    vi.stubGlobal('WebSocket', class extends MockWebSocket {
+      constructor() {
+        super()
+        socket = this
+      }
+    })
+    const client = createCompanionControlClient('ws://127.0.0.1:49152', 'secret-token')
+    const connection = client.connect()
+    socket!.readyState = MockWebSocket.OPEN
+    socket!.emit('open')
+    await Promise.resolve()
+    const handshake = JSON.parse(socket!.sent[0]) as { id: string }
+    socket!.emit('message', { data: JSON.stringify({
+      protocol: COMPANION_CONTROL_PROTOCOL,
+      version: COMPANION_CONTROL_VERSION,
+      type: 'response',
+      id: handshake.id,
+      result: {},
+    }) })
+    await connection
+
+    const pending = client.request('runtime.snapshot')
+    const request = JSON.parse(socket!.sent[1]) as { id: string }
+    const rejection = expect(pending).rejects.toThrow('Companion Control request timed out')
+    await vi.advanceTimersByTimeAsync(5_000)
+    await rejection
+    socket!.emit('message', { data: JSON.stringify({
+      protocol: COMPANION_CONTROL_PROTOCOL,
+      version: COMPANION_CONTROL_VERSION,
+      type: 'response',
+      id: request.id,
+      result: { late: true },
+    }) })
+    await client.close()
+    vi.useRealTimers()
+  })
+})
