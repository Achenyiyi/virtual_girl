diff --git a/apps/stage-tamagotchi/src/shared/companion-control.ts b/apps/stage-tamagotchi/src/shared/companion-control.ts
new file mode 100644
index 00000000..f7f9854a
--- /dev/null
+++ b/apps/stage-tamagotchi/src/shared/companion-control.ts
@@ -0,0 +1,79 @@
+export const COMPANION_CONTROL_PROTOCOL = 'companion-control'
+export const COMPANION_CONTROL_VERSION = 1
+export const COMPANION_CONTROL_IPC_REQUEST = 'companion-control:request'
+export const COMPANION_CONTROL_IPC_EVENT = 'companion-control:event'
+export const COMPANION_CONTROL_IPC_WINDOW_MODE = 'companion-control:window-mode'
+
+export type CompanionWindowMode = 'standard' | 'compact'
+export type CompanionCredentialKind = 'llm' | 'tts'
+export type CompanionControlEventName
+  = | 'runtime.snapshot'
+    | 'conversation.turn.started'
+    | 'conversation.response.delta'
+    | 'conversation.turn.interrupted'
+    | 'conversation.turn.completed'
+    | 'conversation.turn.failed'
+    | 'voice.state.changed'
+    | 'emotion.changed'
+
+export interface CompanionControlEvent {
+  event: CompanionControlEventName
+  sequence: number
+  payload: Record<string, unknown>
+}
+
+export function createCompanionConnectionErrorEvent(): CompanionControlEvent {
+  return {
+    event: 'runtime.snapshot',
+    sequence: 0,
+    payload: {
+      phase: 'error',
+      capabilities: {
+        text_chat: false,
+        voice_input: false,
+        speech_output: false,
+        avatar: false,
+      },
+      active_turn: null,
+      error: {
+        code: 'control_disconnected',
+        message: '桌面宿主连接已断开。',
+        retryable: true,
+      },
+    },
+  }
+}
+
+export interface CompanionControlApi {
+  enabled: boolean
+  runtimeSnapshot: () => Promise<Record<string, unknown>>
+  runtimeRetry: () => Promise<{ accepted: boolean }>
+  listSessions: (params?: { cursor?: string, limit?: number }) => Promise<Record<string, unknown>>
+  history: (params: { session_id: string, cursor?: string, limit?: number }) => Promise<Record<string, unknown>>
+  send: (params: { text: string, speak: boolean }) => Promise<{ turn_id: string }>
+  cancel: (params: { turn_id: string }) => Promise<{ cancelled: boolean }>
+  startVoice: () => Promise<{ started: boolean }>
+  stopVoice: () => Promise<{ stopped: boolean }>
+  setCredential: (params: { kind: CompanionCredentialKind, value: string, overwrite: boolean }) => Promise<Record<string, unknown>>
+  quit: () => Promise<{ accepted: boolean }>
+  setWindowMode: (mode: CompanionWindowMode) => Promise<void>
+  subscribe: (listener: (event: CompanionControlEvent) => void) => () => void
+}
+
+export interface CompanionControlEnvironment {
+  [key: string]: string | undefined
+  COMPANION_CONTROL_URL?: string
+  COMPANION_CONTROL_TOKEN?: string
+}
+
+export function consumeCompanionControlEnvironment(environment: CompanionControlEnvironment): { url: string, token: string } | undefined {
+  const url = environment.COMPANION_CONTROL_URL?.trim()
+  const token = environment.COMPANION_CONTROL_TOKEN?.trim()
+  delete environment.COMPANION_CONTROL_URL
+  delete environment.COMPANION_CONTROL_TOKEN
+  if (!url && !token)
+    return undefined
+  if (!url || !token || !/^ws:\/\/127\.0\.0\.1:\d{1,5}$/.test(url))
+    throw new Error('Companion Control environment is invalid')
+  return { url, token }
+}
