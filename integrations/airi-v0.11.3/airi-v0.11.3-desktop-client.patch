+
+    expect(Object.keys(exposedState.api ?? {}).sort()).toEqual([
+      'cancel',
+      'enabled',
+      'history',
+      'listSessions',
+      'quit',
+      'runtimeRetry',
+      'runtimeSnapshot',
+      'send',
+      'setCredential',
+      'setWindowMode',
+      'startVoice',
+      'stopVoice',
+      'subscribe',
+    ])
+    expect(Object.keys(exposedState.electron ?? {})).toEqual(['ipcRenderer'])
+    expect(Object.keys((exposedState.electron?.ipcRenderer as Record<string, unknown>) ?? {}).sort()).toEqual([
+      'on',
+      'removeListener',
+      'send',
+    ])
+    expect(processState.env.COMPANION_CONTROL_PRELOAD_ENABLED).toBeUndefined()
+    expect(JSON.stringify(exposedState)).not.toContain('secret-token')
+    expect(exposedState.electron).not.toHaveProperty('ipcRenderer.invoke')
+    expect(exposedState.electron).not.toHaveProperty('ipcRenderer.sendSync')
