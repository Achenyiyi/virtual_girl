+const EVENTA_MESSAGE_CHANNEL = 'eventa-message'
+const EVENTA_PUSH_CHANNEL = 'eventa-push'
+const EVENTA_ERROR_CHANNEL = 'eventa-error'
+
+const ALLOWED_CHANNELS = new Set([
+  EVENTA_MESSAGE_CHANNEL,
+  EVENTA_PUSH_CHANNEL,
+  EVENTA_ERROR_CHANNEL,
+])
+
+// Eventa appends the correlation id to receive events, so the immutable base id is
+// followed by exactly one generated segment. Each direction has a separate allowlist:
+// renderer requests may only receive main responses, while renderer responses may
+// only answer the avatar invoke initiated by Electron main.
+const INBOUND_CORRELATED_RESPONSE_IDS = new Set([
+  'eventa:invoke:electron:avatar-bridge:managed-model:get-receive',
+  'eventa:invoke:electron:avatar-bridge:managed-model:get-receive-error',
+  'eventa:event:electron:screen:start-loop-get-cursor-screen-point-receive',
+  'eventa:event:electron:screen:start-loop-get-cursor-screen-point-receive-error',
+  'eventa:event:electron:window:start-loop-get-bounds-receive',
+  'eventa:event:electron:window:start-loop-get-bounds-receive-error',
+  'eventa:invoke:electron:window:get-lifecycle-state-receive',
+  'eventa:invoke:electron:window:get-lifecycle-state-receive-error',
+  'eventa:invoke:electron:window:set-ignore-mouse-events-receive',
+  'eventa:invoke:electron:window:set-ignore-mouse-events-receive-error',
+  'eventa:invoke:electron:window:resize-receive',
+  'eventa:invoke:electron:window:resize-receive-error',
+])
+
+const OUTBOUND_CORRELATED_RESPONSE_IDS = new Set([
+  'eventa:invoke:electron:avatar-bridge:renderer-receive',
+  'eventa:invoke:electron:avatar-bridge:renderer-receive-error',
+])
+
+const ALLOWED_OUTBOUND_IDS = new Set([
+  'eventa:invoke:electron:avatar-bridge:managed-model:get-send',
+  'eventa:invoke:electron:avatar-bridge:managed-model:get-send-abort',
+  'eventa:event:electron:screen:start-loop-get-cursor-screen-point-send',
+  'eventa:event:electron:screen:start-loop-get-cursor-screen-point-send-abort',
+  'eventa:event:electron:window:start-loop-get-bounds-send',
+  'eventa:event:electron:window:start-loop-get-bounds-send-abort',
+  'eventa:invoke:electron:window:get-lifecycle-state-send',
+  'eventa:invoke:electron:window:get-lifecycle-state-send-abort',
+  'eventa:invoke:electron:window:set-ignore-mouse-events-send',
+  'eventa:invoke:electron:window:set-ignore-mouse-events-send-abort',
+  'eventa:invoke:electron:window:resize-send',
+  'eventa:invoke:electron:window:resize-send-abort',
+])
+
+const ALLOWED_INBOUND_IDS = new Set([
+  'eventa:event:electron:screen:cursor-screen-point',
+  'eventa:event:electron:window:bounds',
+  'eventa:event:electron:window:lifecycle-changed',
+  'eventa:invoke:electron:avatar-bridge:renderer-send',
+  'eventa:invoke:electron:avatar-bridge:renderer-send-abort',
+])
+
+interface EventaEnvelope {
+  id: string
+  type: string
+  payload: {
+    body?: unknown
+  }
+}
+
+interface EventaBody {
+  invokeId?: string
+}
+
+type EventaListener = (event: Electron.IpcRendererEvent, ...args: unknown[]) => void
+
+interface IpcRendererTransport {
+  send: (channel: string, ...args: unknown[]) => unknown
+  on: (channel: string, listener: EventaListener) => unknown
+  removeListener: (channel: string, listener: EventaListener) => unknown
+}
+
+export interface CompanionEventaIpcRenderer {
+  send: (channel: string, ...args: unknown[]) => void
+  on: (channel: string, listener: EventaListener) => () => void
+  removeListener: (channel: string, listener: EventaListener) => CompanionEventaIpcRenderer
+}
+
+export interface CompanionEventaElectronApi {
+  ipcRenderer: CompanionEventaIpcRenderer
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value)
+}
+
+function parseEnvelope(value: unknown): EventaEnvelope | undefined {
+  if (!isRecord(value)
+    || typeof value.id !== 'string'
+    || !value.id
+    || value.id.length > 128
+    || typeof value.type !== 'string'
+    || !value.type
+    || value.type.length > 256
+    || !isRecord(value.payload)) {
+    return undefined
+  }
+
+  return value as unknown as EventaEnvelope
+}
+
+function parseBody(envelope: EventaEnvelope): EventaBody | undefined {
+  if (typeof envelope.payload.body === 'undefined')
+    return {}
+  if (!isRecord(envelope.payload.body))
+    return undefined
+  return envelope.payload.body
+}
+
+function correlationIdFromType(id: string, direction: 'inbound' | 'outbound'): string | undefined {
+  const bases = direction === 'outbound'
+    ? OUTBOUND_CORRELATED_RESPONSE_IDS
+    : INBOUND_CORRELATED_RESPONSE_IDS
+
+  for (const base of bases) {
+    const marker = `${base}-`
+    if (!id.startsWith(marker))
+      continue
+
+    const correlationId = id.slice(marker.length)
+    return /^\w{16}$/u.test(correlationId) ? correlationId : undefined
+  }
+
+  return undefined
+}
+
+function isAllowedType(type: string, direction: 'inbound' | 'outbound'): boolean {
+  const allowed = direction === 'outbound' ? ALLOWED_OUTBOUND_IDS : ALLOWED_INBOUND_IDS
+  return allowed.has(type) || Boolean(correlationIdFromType(type, direction))
+}
+
+function isInvokeSendType(type: string): boolean {
+  return type.endsWith('-send') && type.includes(':invoke:')
+}
+
+function isInvokeReceiveType(type: string): boolean {
+  return type.endsWith('-receive')
+}
+
+function isInvokeAbortType(type: string): boolean {
+  return type.endsWith('-send-abort')
+}
+
+function isValidInvokeBody(envelope: EventaEnvelope, direction: 'inbound' | 'outbound'): boolean {
+  const correlatedId = correlationIdFromType(envelope.type, direction)
+  if (correlatedId) {
+    const body = parseBody(envelope)
+    return body?.invokeId === correlatedId
+  }
+
+  if (!isInvokeSendType(envelope.type)
+    && !isInvokeReceiveType(envelope.type)
+    && !isInvokeAbortType(envelope.type)) {
+    return true
+  }
+
+  const body = parseBody(envelope)
+  return typeof body?.invokeId === 'string' && /^\w{16}$/u.test(body.invokeId)
+}
+
+/**
+ * Creates the renderer's Eventa-only IPC surface for Companion Desktop.
+ *
+ * The proxy preserves Eventa's `send/on/removeListener` adapter contract while
+ * rejecting all other Electron channels and every Eventa method outside the exact
+ * stage/avatar/window allowlist. No Node, socket, token, invoke, sync, transfer, or
+ * generic IPC primitive crosses into the renderer.
+ */
+export function createCompanionEventaElectronApi(ipcRenderer: IpcRendererTransport): CompanionEventaElectronApi {
+  const listenerWrappers = new Map<EventaListener, EventaListener>()
+
+  const restrictedIpcRenderer: CompanionEventaIpcRenderer = {
+    send(channel: string, ...args: unknown[]): void {
+      if (channel !== EVENTA_MESSAGE_CHANNEL || args.length !== 1)
+        throw new Error('Companion Desktop IPC channel is unavailable')
+
+      const envelope = parseEnvelope(args[0])
+      if (!envelope || !isAllowedType(envelope.type, 'outbound') || !isValidInvokeBody(envelope, 'outbound'))
+        throw new Error('Companion Desktop Eventa method is unavailable')
+
+      ipcRenderer.send(channel, envelope)
+    },
+    on(channel: string, listener: EventaListener): () => void {
+      if (!ALLOWED_CHANNELS.has(channel))
+        throw new Error('Companion Desktop IPC channel is unavailable')
+
+      const wrapped: EventaListener = (event, ...args) => {
+        if (channel === EVENTA_ERROR_CHANNEL) {
+          // Eventa's error channel may carry a native Error with stack and paths.
+          // The renderer only needs a generic signal to reject pending work safely.
+          listener(event, { message: 'Companion Desktop Eventa transport failed' })
+          return
+        }
+
+        if (args.length !== 1)
+          return
+        const envelope = parseEnvelope(args[0])
+        if (!envelope || !isAllowedType(envelope.type, 'inbound') || !isValidInvokeBody(envelope, 'inbound'))
+          return
+        listener(event, envelope)
+      }
+      listenerWrappers.set(listener, wrapped)
+      ipcRenderer.on(channel, wrapped)
+      return () => restrictedIpcRenderer.removeListener(channel, listener)
+    },
+    removeListener(channel: string, listener: EventaListener) {
+      if (!ALLOWED_CHANNELS.has(channel))
+        throw new Error('Companion Desktop IPC channel is unavailable')
+
+      const wrapped = listenerWrappers.get(listener)
+      if (wrapped) {
+        listenerWrappers.delete(listener)
+        ipcRenderer.removeListener(channel, wrapped)
+      }
+      return restrictedIpcRenderer
+    },
+  }
+
+  return { ipcRenderer: restrictedIpcRenderer }
+}
