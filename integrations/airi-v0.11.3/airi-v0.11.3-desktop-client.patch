index 00000000..1fde4c96
--- /dev/null
+++ b/apps/stage-tamagotchi/src/main/services/airi/companion-control/client.ts
@@ -0,0 +1,284 @@
+import type { WebContents } from 'electron'
+
+import type { CompanionControlEvent, CompanionWindowMode } from '../../../../shared/companion-control'
+
+import { Buffer } from 'node:buffer'
+import { randomUUID } from 'node:crypto'
+
+import { ipcMain } from 'electron'
+
+import {
+  COMPANION_CONTROL_IPC_EVENT,
+  COMPANION_CONTROL_IPC_REQUEST,
+  COMPANION_CONTROL_IPC_WINDOW_MODE,
+  COMPANION_CONTROL_PROTOCOL,
+  COMPANION_CONTROL_VERSION,
+  consumeCompanionControlEnvironment,
+  createCompanionConnectionErrorEvent,
+} from '../../../../shared/companion-control'
+
+const MAX_MESSAGE_BYTES = 256 * 1024
+const RPC_TIMEOUT_MS = 5000
+const MAX_RENDERER_REQUESTS = 8
+const ALLOWED_EVENT_NAMES = new Set<CompanionControlEvent['event']>([
+  'runtime.snapshot',
+  'conversation.turn.started',
+  'conversation.response.delta',
+  'conversation.turn.interrupted',
+  'conversation.turn.completed',
+  'conversation.turn.failed',
+  'voice.state.changed',
+  'emotion.changed',
+])
+const ALLOWED_METHODS = new Set([
+  'runtime.snapshot',
+  'runtime.retry',
+  'conversation.sessions.list',
+  'conversation.history',
+  'conversation.send',
+  'conversation.cancel',
+  'voice.start',
+  'voice.stop',
+  'credential.set',
+  'application.quit',
+])
+
+interface PendingRequest {
+  resolve: (value: Record<string, unknown>) => void
+  reject: (error: Error) => void
+  timeout: ReturnType<typeof setTimeout>
+}
+
+interface RpcError {
+  code?: unknown
+  message?: unknown
+  retryable?: unknown
+}
+
+type CompanionControlRenderer = Pick<WebContents, 'id' | 'isDestroyed' | 'send'>
+
+export interface CompanionControlClient {
+  enabled: boolean
+  connect: () => Promise<void>
+  close: () => Promise<void>
+  request: (method: string, params?: Record<string, unknown>) => Promise<Record<string, unknown>>
+  installIpc: (webContents: CompanionControlRenderer, setWindowMode: (mode: CompanionWindowMode) => void) => () => void
+}
+
+export function createCompanionControlClientFromEnvironment(environment: NodeJS.ProcessEnv): CompanionControlClient | undefined {
+  const configuration = consumeCompanionControlEnvironment(environment)
+  if (!configuration)
+    return undefined
+  return createCompanionControlClient(configuration.url, configuration.token)
+}
+
+export function createCompanionControlClient(url: string, token: string): CompanionControlClient {
+  let socket: WebSocket | undefined
+  let authenticated = false
+  let intentionalClose = false
+  let lastEventSequence = -1
+  let rendererRequests = 0
+  let connectionPromise: Promise<void> | undefined
+  let launchToken = token
+  let renderer: CompanionControlRenderer | undefined
+  const pending = new Map<string, PendingRequest>()
+
+  function forwardToRenderer(event: CompanionControlEvent): void {
+    if (renderer && !renderer.isDestroyed())
+      renderer.send(COMPANION_CONTROL_IPC_EVENT, event)
+  }
+
+  function rejectPending(message: string): void {
+    for (const request of pending.values()) {
+      clearTimeout(request.timeout)
+      request.reject(new Error(message))
+    }
+    pending.clear()
+  }
+
+  function parseMessage(raw: string): Record<string, unknown> {
+    if (Buffer.byteLength(raw, 'utf8') > MAX_MESSAGE_BYTES)
+      throw new Error('Companion Control message exceeded limit')
+    const value: unknown = JSON.parse(raw)
+    if (!value || typeof value !== 'object' || Array.isArray(value))
+      throw new Error('Companion Control message is invalid')
+    return value as Record<string, unknown>
+  }
+
+  function onMessage(event: MessageEvent<string>): void {
+    let message: Record<string, unknown>
+    try {
+      message = parseMessage(event.data)
+    }
+    catch {
+      forwardToRenderer(createCompanionConnectionErrorEvent())
+      void close()
+      return
+    }
+    if (message.protocol !== COMPANION_CONTROL_PROTOCOL || message.version !== COMPANION_CONTROL_VERSION)
+      return
+    if (message.type === 'event') {
+      if (!authenticated
+        || typeof message.event !== 'string'
+        || !ALLOWED_EVENT_NAMES.has(message.event as CompanionControlEvent['event'])
+        || !Number.isSafeInteger(message.sequence)
+        || (message.sequence as number) < 0
+        || (message.sequence as number) <= lastEventSequence
+        || typeof message.payload !== 'object'
+        || message.payload === null
+        || Array.isArray(message.payload)) {
+        return
+      }
+      lastEventSequence = message.sequence as number
+      const forwarded: CompanionControlEvent = {
+        event: message.event as CompanionControlEvent['event'],
+        sequence: message.sequence as number,
+        payload: message.payload as Record<string, unknown>,
+      }
+      forwardToRenderer(forwarded)
+      return
+    }
+    const requestId = typeof message.id === 'string' ? message.id : ''
+    const request = pending.get(requestId)
+    if (!request)
+      return
+    pending.delete(requestId)
+    clearTimeout(request.timeout)
+    if (message.type === 'response') {
+      request.resolve(typeof message.result === 'object' && message.result !== null
+        ? message.result as Record<string, unknown>
+        : {})
+      return
+    }
+    const error = typeof message.error === 'object' && message.error !== null
+      ? message.error as RpcError
+      : {}
+    request.reject(new Error(typeof error.message === 'string' ? error.message : 'Companion Control request failed'))
+  }
+
+  function sendRequest(method: string, params: Record<string, unknown> = {}): Promise<Record<string, unknown>> {
+    if (!socket || socket.readyState !== WebSocket.OPEN)
+      return Promise.reject(new Error('Companion Control is disconnected'))
+    const requestId = randomUUID()
+    const message = JSON.stringify({
+      protocol: COMPANION_CONTROL_PROTOCOL,
+      version: COMPANION_CONTROL_VERSION,
+      type: 'request',
+      id: requestId,
+      method,
+      params,
+    })
+    if (Buffer.byteLength(message, 'utf8') > MAX_MESSAGE_BYTES)
+      return Promise.reject(new Error('Companion Control request exceeded limit'))
+    return new Promise((resolve, reject) => {
+      const timeout = setTimeout(() => {
+        pending.delete(requestId)
+        reject(new Error('Companion Control request timed out'))
+      }, RPC_TIMEOUT_MS)
+      pending.set(requestId, { resolve, reject, timeout })
+      socket!.send(message)
+    })
+  }
+
+  async function connectOnce(): Promise<void> {
+    if (authenticated)
+      return
+    intentionalClose = false
+    lastEventSequence = -1
+    socket = new WebSocket(url)
+    socket.addEventListener('message', onMessage)
+    socket.addEventListener('close', () => {
+      authenticated = false
+      rejectPending('Companion Control disconnected')
+      if (!intentionalClose)
+        forwardToRenderer(createCompanionConnectionErrorEvent())
+    })
+    await new Promise<void>((resolve, reject) => {
+      const timeout = setTimeout(() => reject(new Error('Companion Control connection timed out')), RPC_TIMEOUT_MS)
+      socket!.addEventListener('open', () => {
+        clearTimeout(timeout)
+        resolve()
+      }, { once: true })
+      socket!.addEventListener('error', () => {
+        clearTimeout(timeout)
+        reject(new Error('Companion Control connection failed'))
+      }, { once: true })
+    })
+    await sendRequest('handshake', { token: launchToken, version: COMPANION_CONTROL_VERSION })
+    authenticated = true
+    launchToken = ''
+  }
+
+  async function connect(): Promise<void> {
+    if (authenticated)
+      return
+    if (!launchToken)
+      throw new Error('Companion Control cannot reconnect after the launch token was consumed')
+    if (!connectionPromise) {
+      connectionPromise = connectOnce().finally(() => {
+        connectionPromise = undefined
+      })
+    }
+    await connectionPromise
+  }
+
+  async function close(): Promise<void> {
+    intentionalClose = true
+    authenticated = false
+    launchToken = ''
+    rejectPending('Companion Control closed')
+    const active = socket
+    socket = undefined
+    if (active && active.readyState < WebSocket.CLOSING)
+      active.close(1000, 'AIRI closing')
+  }
+
+  function installIpc(webContents: CompanionControlRenderer, setWindowMode: (mode: CompanionWindowMode) => void): () => void {
+    renderer = webContents
+    const rendererId = webContents.id
+    const handleRequest = async (event: Electron.IpcMainInvokeEvent, payload: unknown) => {
+      if (event.sender.id !== rendererId)
+        throw new Error('Companion Control renderer is unauthorized')
+      if (!payload || typeof payload !== 'object' || Array.isArray(payload))
+        throw new Error('Invalid Companion Control request')
+      const request = payload as { method?: unknown, params?: unknown }
+      if (typeof request.method !== 'string' || !ALLOWED_METHODS.has(request.method))
+        throw new Error('Companion Control method is unavailable')
+      const params = request.params && typeof request.params === 'object' && !Array.isArray(request.params)
+        ? request.params as Record<string, unknown>
+        : {}
+      if (rendererRequests >= MAX_RENDERER_REQUESTS)
+        throw new Error('Too many concurrent Companion Control requests')
+      rendererRequests += 1
+      try {
+        await connect()
+        return await sendRequest(request.method, params)
+      }
+      finally {
+        rendererRequests -= 1
+      }
+    }
+    const handleMode = (event: Electron.IpcMainEvent, mode: unknown) => {
+      if (event.sender.id !== rendererId)
+        return
+      if (mode === 'standard' || mode === 'compact')
+        setWindowMode(mode)
+    }
+    ipcMain.handle(COMPANION_CONTROL_IPC_REQUEST, handleRequest)
+    ipcMain.on(COMPANION_CONTROL_IPC_WINDOW_MODE, handleMode)
+    return () => {
+      renderer = undefined
+      rendererRequests = 0
+      ipcMain.removeHandler(COMPANION_CONTROL_IPC_REQUEST)
+      ipcMain.removeListener(COMPANION_CONTROL_IPC_WINDOW_MODE, handleMode)
+    }
+  }
+
+  return {
+    enabled: true,
+    connect,
+    close,
+    request: sendRequest,
+    installIpc,
+  }
+}
