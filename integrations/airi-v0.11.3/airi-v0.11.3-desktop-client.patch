+import type { BrowserWindow, IpcMain } from 'electron'
+
+import { createContext } from '@moeru/eventa/adapters/electron/main'
+import { ipcMain } from 'electron'
+
+export type CompanionWindowEventaContext = ReturnType<typeof createContext>
+
+export function createCompanionWindowEventaContext(params: {
+  window: BrowserWindow
+  ipcMain?: IpcMain
+}): CompanionWindowEventaContext {
+  const sourceIpcMain = params.ipcMain ?? ipcMain
+  const listenerWrappers = new Map<Parameters<IpcMain['on']>[1], Parameters<IpcMain['on']>[1]>()
+  const windowBoundIpcMain = new Proxy(sourceIpcMain, {
+    get(target, property, receiver) {
+      if (property === 'on') {
+        return (channel: string, listener: Parameters<IpcMain['on']>[1]) => {
+          const wrapped: typeof listener = (event, ...args) => {
+            if (event.sender.id === params.window.webContents.id)
+              listener(event, ...args)
+          }
+          listenerWrappers.set(listener, wrapped)
+          target.on(channel, wrapped)
+          return windowBoundIpcMain
+        }
+      }
+      if (property === 'off') {
+        return (channel: string, listener: Parameters<IpcMain['off']>[1]) => {
+          const wrapped = listenerWrappers.get(listener)
+          if (wrapped) {
+            listenerWrappers.delete(listener)
+            target.off(channel, wrapped)
+          }
+          return windowBoundIpcMain
+        }
+      }
+
+      const value: unknown = Reflect.get(target, property, receiver)
+      return typeof value === 'function' ? value.bind(target) : value
+    },
+  })
+
+  return createContext(windowBoundIpcMain, params.window, { onlySameWindow: true })
+}
