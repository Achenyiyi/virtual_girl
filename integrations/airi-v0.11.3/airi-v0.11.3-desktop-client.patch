+import type { BrowserWindow } from 'electron'
+
+import type { CompanionWindowEventaContext } from './companion-eventa.electron'
+
+import { createScreenService, createWindowService } from '../../../services/electron'
+import { createCompanionWindowEventaContext } from './companion-eventa.electron'
+
+/**
+ * Installs only the Eventa handlers required by the Companion Desktop stage.
+ *
+ * This intentionally omits app quit, onboarding, auth, updater, plugin, MCP,
+ * Godot, widgets, server-channel and settings handlers. Application shutdown is
+ * available only through the narrow Companion Control preload API.
+ */
+export function setupCompanionWindowElectronInvokes(params: {
+  window: BrowserWindow
+  eventa?: CompanionWindowEventaContext
+}): () => void {
+  const eventa = params.eventa ?? createCompanionWindowEventaContext(params)
+  const { context } = eventa
+  createScreenService({ context, window: params.window })
+  createWindowService({ context, window: params.window })
+  return eventa.dispose
+}
