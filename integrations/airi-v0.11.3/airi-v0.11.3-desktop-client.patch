+  it('subscribes only to the fixed Control event channel and removes the exact wrapper', async () => {
+    await import('./index')
+    const listener = vi.fn<(event: CompanionControlEvent) => void>()
+    const api = exposedState.api as { subscribe: (callback: typeof listener) => () => void }
+
+    const unsubscribe = api.subscribe(listener)
+    const [channel, wrapped] = electronState.on.mock.calls[0]
+    const event: CompanionControlEvent = {
+      event: 'runtime.snapshot',
+      sequence: 1,
+      payload: { phase: 'ready' },
+    }
+    wrapped({}, event)
+    unsubscribe()
+
+    expect(channel).toBe('companion-control:event')
+    expect(listener).toHaveBeenCalledOnce()
+    expect(listener).toHaveBeenCalledWith(event)
+    expect(electronState.removeListener).toHaveBeenCalledOnce()
+    expect(electronState.removeListener).toHaveBeenCalledWith('companion-control:event', wrapped)
