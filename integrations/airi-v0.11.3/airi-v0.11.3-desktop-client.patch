+import { readFileSync } from 'node:fs'
+
+import { describe, expect, it } from 'vitest'
+
+const mainSource = readFileSync(new URL('./index.ts', import.meta.url), 'utf8')
+const windowSource = readFileSync(new URL('./windows/main/index.ts', import.meta.url), 'utf8')
+const rendererSource = readFileSync(new URL('../renderer/CompanionApp.vue', import.meta.url), 'utf8')
+const stageSource = readFileSync(new URL('../renderer/components/companion-desktop/CompanionDesktopStage.vue', import.meta.url), 'utf8')
+
+describe('companion desktop runtime boundary', () => {
+  it('returns from the minimal main-process graph before full AIRI providers are declared', () => {
+    const companionBranch = mainSource.indexOf('if (companionControl) {')
+    const companionReturn = mainSource.indexOf('return', companionBranch)
+    const fullRuntimeGraph = mainSource.indexOf('injeca.provide(\'modules:channel-server\'')
+
+    expect(companionBranch).toBeGreaterThan(-1)
+    expect(companionReturn).toBeGreaterThan(companionBranch)
+    expect(fullRuntimeGraph).toBeGreaterThan(companionReturn)
+    expect(mainSource).toContain('if (!companionControl)\n    setupMediaPermissionHandlers(session.defaultSession)')
+  })
+
+  it('loads a dedicated companion renderer and minimal Eventa handlers', () => {
+    expect(windowSource).toContain('companionDesktop ? \'companion.html\' : undefined')
+    expect(windowSource).toContain('setupCompanionWindowElectronInvokes({ window, eventa: avatarEventa })')
+    expect(windowSource).toContain('setupMainWindowElectronInvokes({')
+  })
+
+  it('installs managed avatar and Control IPC before loading the companion renderer', () => {
+    const managedAvatarHandler = windowSource.indexOf('const cleanupManagedAvatarHandler = defineInvokeHandler(')
+    const installControlIpc = windowSource.indexOf('const cleanupCompanionIpc = params.companionControl.installIpc(')
+    const connectControl = windowSource.indexOf('await params.companionControl.connect()')
+    const registerControlCleanup = windowSource.indexOf('onAppBeforeQuit(async () => {', connectControl)
+    const rendererLoad = windowSource.indexOf('await load(window, baseUrl(')
+
+    expect(managedAvatarHandler).toBeGreaterThan(-1)
+    expect(installControlIpc).toBeGreaterThan(managedAvatarHandler)
+    expect(connectControl).toBeGreaterThan(installControlIpc)
+    expect(registerControlCleanup).toBeGreaterThan(connectControl)
+    expect(rendererLoad).toBeGreaterThan(registerControlCleanup)
+  })
+
+  it('does not initialize full AIRI renderer services in the companion entrypoint', () => {
+    expect(rendererSource).not.toContain('useAuthProviderSync')
+    expect(rendererSource).not.toContain('useSharedAnalyticsStore')
+    expect(rendererSource).not.toContain('useModsServerChannelStore')
+    expect(rendererSource).not.toContain('useTamagotchiMcpToolsStore')
+    expect(rendererSource).not.toContain('useTamagotchiPluginToolsStore')
+    expect(rendererSource).not.toContain('useOnboardingStore')
+    expect(rendererSource).not.toContain('useChatSessionStore')
+  })
+
+  it('notifies the avatar runtime when the dedicated stage unmounts', () => {
+    expect(stageSource).toContain('onUnmounted(() => props.runtime.notifyStageUnmounted())')
+  })
+})
