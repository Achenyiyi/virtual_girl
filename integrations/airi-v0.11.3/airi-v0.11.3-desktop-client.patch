+const credentialTrigger = ref<HTMLElement | null>(null)
+const compactOverlayTrigger = ref<HTMLElement | null>(null)
+let unsubscribe: (() => void) | undefined
+
+const identityName = computed(() => snapshot.value.identity?.name || '虚拟伙伴')
+const activeTurnId = computed(() => snapshot.value.active_turn?.turn_id || '')
+const canSend = computed(() => snapshot.value.capabilities?.text_chat && !activeTurnId.value && !busy.value && text.value.trim().length > 0)
+const microphoneOn = computed(() => snapshot.value.voice?.enabled === true)
+const voiceInputAvailable = computed(() => snapshot.value.capabilities?.voice_input === true)
+const microphoneDisabled = computed(() => !voiceInputAvailable.value || (Boolean(activeTurnId.value) && !microphoneOn.value))
+const microphoneLabel = computed(() => microphoneOn.value ? '停止连续语音' : '开启连续语音')
+const emotionLabel = computed(() => ({
+  neutral: '平静',
+  calm: '平静',
+  happy: '开心',
+  joy: '愉悦',
+  excited: '兴奋',
+  sad: '低落',
+  angry: '生气',
+  fear: '紧张',
+  surprise: '惊讶',
+  disgust: '不适',
+  thinking: '思考中',
+}[snapshot.value.emotion?.dominant?.toLowerCase() || 'neutral'] || '状态稳定'))
+const voiceStateLabel = computed(() => {
+  if (!microphoneOn.value)
+    return '麦克风关闭'
+  return ({
+    listening: '正在聆听',
+    capturing: '正在收音',
+    recording: '正在收音',
