+import type { IpcRenderer } from '@electron-toolkit/preload'
+import type { BrowserWindow, IpcMain, IpcMainEvent, IpcRendererEvent, WebContents } from 'electron'
+
+import type { CompanionEventaIpcRenderer } from './companion-eventa'
+
+import { defineInvoke, defineInvokeHandler } from '@moeru/eventa'
+import { createContext as createRendererContext } from '@moeru/eventa/adapters/electron/renderer'
+import { describe, expect, it, vi } from 'vitest'
+
+import { createCompanionWindowEventaContext } from '../main/windows/main/rpc/companion-eventa.electron'
+import { avatarManagedModelGet, avatarRendererInvoke, electron } from '../shared/eventa'
+import { createCompanionEventaElectronApi } from './companion-eventa'
+
+vi.mock('electron', () => ({ ipcMain: undefined }))
+
+type MainListener = (event: IpcMainEvent, ...args: unknown[]) => void
+type RendererListener = (event: IpcRendererEvent, ...args: unknown[]) => void
+
+function createMemoryElectronTransport() {
+  const mainListeners = new Map<string, Set<MainListener>>()
+  const rendererListeners = new Map<string, Set<RendererListener>>()
+  const foreignRendererListeners = new Map<string, Set<RendererListener>>()
+
+  function addListener<T extends (...args: never[]) => unknown>(
+    listeners: Map<string, Set<T>>,
+    channel: string,
+    listener: T,
+  ) {
+    const channelListeners = listeners.get(channel) ?? new Set<T>()
+    channelListeners.add(listener)
+    listeners.set(channel, channelListeners)
+  }
+
+  function removeListener<T extends (...args: never[]) => unknown>(
+    listeners: Map<string, Set<T>>,
+    channel: string,
+    listener: T,
+  ) {
+    listeners.get(channel)?.delete(listener)
+  }
+
+  const rendererWebContents = {
+    id: 41,
+    isDestroyed: () => false,
+    send(channel: string, ...args: unknown[]) {
+      for (const listener of rendererListeners.get(channel) ?? [])
+        listener({} as IpcRendererEvent, ...args)
+    },
+  } as WebContents
+  const foreignWebContents = {
+    id: 42,
+    isDestroyed: () => false,
+    send(channel: string, ...args: unknown[]) {
+      for (const listener of foreignRendererListeners.get(channel) ?? [])
+        listener({} as IpcRendererEvent, ...args)
+    },
+  } as WebContents
+
+  const ipcMain = {
+    on(channel: string, listener: MainListener) {
+      addListener(mainListeners, channel, listener)
+      return ipcMain
+    },
+    off(channel: string, listener: MainListener) {
+      removeListener(mainListeners, channel, listener)
+      return ipcMain
+    },
+  } as IpcMain
+  const ipcMainOff = vi.spyOn(ipcMain, 'off')
+
+  function createRendererTransport(sender: WebContents, listeners: Map<string, Set<RendererListener>>): IpcRenderer {
+    const transport: IpcRenderer = {
+      send(channel: string, ...args: unknown[]) {
+        for (const listener of mainListeners.get(channel) ?? [])
+          listener({ sender } as IpcMainEvent, ...args)
+      },
+      on(channel: string, listener: RendererListener) {
+        addListener(listeners, channel, listener)
+        return () => removeListener(listeners, channel, listener)
+      },
+      removeListener(channel: string, listener: RendererListener) {
+        removeListener(listeners, channel, listener)
+        return transport
+      },
+      once(channel: string, listener: RendererListener) {
+        const onceListener: RendererListener = (event, ...args) => {
+          removeListener(listeners, channel, onceListener)
+          listener(event, ...args)
+        }
+        addListener(listeners, channel, onceListener)
+        return () => removeListener(listeners, channel, onceListener)
+      },
+      removeAllListeners(channel: string) {
+        listeners.delete(channel)
+      },
+      invoke: vi.fn(),
+      postMessage: vi.fn(),
+      sendSync: vi.fn(),
+      sendTo: vi.fn(),
+      sendToHost: vi.fn(),
+    }
+    return transport
+  }
+
+  const browserWindow = {
+    isDestroyed: () => false,
+    webContents: rendererWebContents,
+  } as BrowserWindow
+
+  return {
+    browserWindow,
+    foreignRenderer: createRendererTransport(foreignWebContents, foreignRendererListeners),
+    ipcMain,
+    ipcMainOff,
+    mainListeners,
+    renderer: createRendererTransport(rendererWebContents, rendererListeners),
+    window: browserWindow,
+  }
+}
+
+function createRendererContextAdapter(restricted: CompanionEventaIpcRenderer): IpcRenderer {
+  const unavailable = () => {
+    throw new Error('Unexpected generic Electron IPC call in Companion Eventa test')
+  }
+  const adapter: IpcRenderer = {
+    send: restricted.send,
+    on: restricted.on,
+    removeListener(channel, listener) {
+      restricted.removeListener(channel, listener)
+      return adapter
+    },
+    once: unavailable,
+    removeAllListeners: unavailable,
+    invoke: unavailable,
+    postMessage: unavailable,
+    sendSync: unavailable,
+    sendTo: unavailable,
+    sendToHost: unavailable,
+  }
+  return adapter
+}
+
+describe('companion desktop Eventa integration boundary', () => {
+  it('round-trips renderer-to-main managed model and window invokes', async () => {
+    const transport = createMemoryElectronTransport()
+    const { context: mainContext } = createCompanionWindowEventaContext(transport)
+    const rendererApi = createCompanionEventaElectronApi(transport.renderer)
+    const { context: rendererContext } = createRendererContext(createRendererContextAdapter(rendererApi.ipcRenderer))
+
+    const managedModel = {
+      id: 'managed-avatar',
+      name: 'Managed Avatar',
+      renderer: 'vrm' as const,
+      url: 'https://127.0.0.1/avatar.vrm',
+    }
+    const resize = vi.fn()
+    defineInvokeHandler(mainContext, avatarManagedModelGet, () => managedModel)
+    defineInvokeHandler(mainContext, electron.window.resize, (payload) => {
+      resize(payload)
+    })
+
+    await expect(defineInvoke(rendererContext, avatarManagedModelGet)()).resolves.toEqual(managedModel)
+    await defineInvoke(rendererContext, electron.window.resize)({
+      deltaX: 8,
+      deltaY: -4,
+      direction: 'se',
+    })
+
+    expect(resize).toHaveBeenCalledOnce()
+    expect(resize).toHaveBeenCalledWith({ deltaX: 8, deltaY: -4, direction: 'se' })
+  })
+
+  it('round-trips main-to-renderer avatar invokes through correlated renderer-receive events', async () => {
+    const transport = createMemoryElectronTransport()
+    const { context: mainContext } = createCompanionWindowEventaContext(transport)
+    const rendererApi = createCompanionEventaElectronApi(transport.renderer)
+    const { context: rendererContext } = createRendererContext(createRendererContextAdapter(rendererApi.ipcRenderer))
+
+    defineInvokeHandler(rendererContext, avatarRendererInvoke, request => ({
+      method: request.method,
+      renderer: 'vrm',
+    }))
+
+    await expect(defineInvoke(mainContext, avatarRendererInvoke)({
+      method: 'health',
+      params: {},
+    })).resolves.toEqual({ method: 'health', renderer: 'vrm' })
+  })
+
+  it('does not let a foreign renderer invoke the companion main context', async () => {
+    const transport = createMemoryElectronTransport()
+    const { context: mainContext } = createCompanionWindowEventaContext(transport)
+    const foreignApi = createCompanionEventaElectronApi(transport.foreignRenderer)
+    const { context: foreignContext, dispose } = createRendererContext(createRendererContextAdapter(foreignApi.ipcRenderer))
+    const handler = vi.fn(() => ({ id: 'should-not-run' }))
+    defineInvokeHandler(mainContext, avatarManagedModelGet, handler)
+
+    const invocation = defineInvoke(foreignContext, avatarManagedModelGet)()
+    dispose(new Error('test disposed pending foreign invoke'))
+
+    await expect(invocation).rejects.toThrow('test disposed pending foreign invoke')
+    expect(handler).not.toHaveBeenCalled()
+  })
+
+  it('removes every underlying ipcMain listener when the window context is disposed', () => {
+    const transport = createMemoryElectronTransport()
+    const { dispose } = createCompanionWindowEventaContext(transport)
+
+    expect(transport.mainListeners.get('eventa-message')).toHaveLength(1)
+    expect(transport.mainListeners.get('eventa-error')).toHaveLength(1)
+
+    dispose()
+
+    expect(transport.ipcMainOff).toHaveBeenCalledTimes(2)
+    expect(transport.mainListeners.get('eventa-message')).toHaveLength(0)
+    expect(transport.mainListeners.get('eventa-error')).toHaveLength(0)
+  })
+})
