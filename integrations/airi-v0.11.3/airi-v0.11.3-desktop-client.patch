+  api: CompanionControlApi
+  loading: boolean
+}>()
+const emit = defineEmits<{
+  (event: 'windowModeChanged', mode: CompanionWindowMode): void
+}>()
+const loading = computed(() => props.loading)
+
+const view = ref<'conversation' | 'history' | 'settings'>('conversation')
+const mode = ref<CompanionWindowMode>('standard')
+const compactOverlay = ref<'history' | 'settings' | null>(null)
+const snapshot = ref<RuntimeSnapshot>({ phase: 'starting' })
+const connected = ref(false)
+const loadingSnapshot = ref(true)
+const turns = ref<TurnView[]>([])
+const sessions = ref<SessionView[]>([])
+const selectedSession = ref<SessionView | null>(null)
+const historyTurns = ref<TurnView[]>([])
+const historyLoading = ref(false)
+const text = ref('')
+const speakText = ref(false)
+const busy = ref(false)
+const credentialKind = ref<CompanionCredentialKind | null>(null)
+const credentialValue = ref('')
+const credentialOverwrite = ref(false)
+const credentialSaving = ref(false)
+const credentialError = ref('')
+const actionError = ref('')
+const panelError = ref('')
+const theme = ref<'system' | 'dark' | 'light'>('system')
+const systemThemeQuery = window.matchMedia('(prefers-color-scheme: dark)')
+const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)')
