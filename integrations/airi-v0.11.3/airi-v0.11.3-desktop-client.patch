+
+const companionEnabled = process.env.COMPANION_CONTROL_PRELOAD_ENABLED === '1'
+delete process.env.COMPANION_CONTROL_PRELOAD_ENABLED
+
+const companion: CompanionControlApi = {
+  enabled: companionEnabled,
+  runtimeSnapshot: () => invoke<Record<string, unknown>>('runtime.snapshot'),
+  runtimeRetry: () => invoke<{ accepted: boolean }>('runtime.retry'),
+  listSessions: params => invoke<Record<string, unknown>>('conversation.sessions.list', params),
+  history: params => invoke<Record<string, unknown>>('conversation.history', params),
