+<script setup lang="ts">
+import type { CompanionControlApi } from '../shared/companion-control'
+
+import { defineInvokeHandler } from '@moeru/eventa'
+import { useElectronEventaContext, useElectronEventaInvoke } from '@proj-airi/electron-vueuse'
+import { DisplayModelFormat, useDisplayModelsStore } from '@proj-airi/stage-ui/stores/display-models'
+import { useSettings } from '@proj-airi/stage-ui/stores/settings'
+import { onMounted, onUnmounted, ref } from 'vue'
+
+import CompanionDesktopStage from './components/companion-desktop/CompanionDesktopStage.vue'
+
+import { AvatarRendererRuntime } from '../shared/avatar-bridge/renderer-runtime'
+import { avatarManagedModelGet, avatarRendererInvoke } from '../shared/eventa'
+
+const companionControl = (window as unknown as { api: CompanionControlApi }).api
+if (!companionControl?.enabled)
+  throw new Error('Companion Desktop renderer requires its dedicated preload capability')
+
+const displayModelsStore = useDisplayModelsStore()
+const settingsStore = useSettings()
+const eventaContext = useElectronEventaContext()
+const getManagedAvatar = useElectronEventaInvoke(avatarManagedModelGet)
+
+const stage = ref<InstanceType<typeof CompanionDesktopStage>>()
+
+const avatarRendererRuntime = new AvatarRendererRuntime({
+  async listModels() {
+    return displayModelsStore.displayModels.map(model => ({
+      id: model.id,
+      name: model.name,
+      renderer: model.format === DisplayModelFormat.Live2dZip || model.format === DisplayModelFormat.Live2dDirectory
+        ? 'live2d'
+        : model.format === DisplayModelFormat.VRM ? 'vrm' : 'unsupported',
+    }))
+  },
+  async selectModel(modelId) {
+    settingsStore.stageModelSelected = modelId
+    await settingsStore.updateStageModel()
+  },
+  async applyState(state) {
+    if (!stage.value)
+      throw new Error('avatar stage is unavailable')
+    await stage.value.applyAvatarState(state)
+  },
+  async applyExpression(expressionId, intensity, durationMs) {
+    if (!stage.value)
+      throw new Error('avatar stage is unavailable')
+    await stage.value.applyAvatarExpression(expressionId, intensity, durationMs)
+  },
+  async applyGesture(gestureId, intensity) {
+    if (!stage.value)
+      throw new Error('avatar stage is unavailable')
+    await stage.value.applyAvatarGesture(gestureId, intensity)
+  },
+  async applyProactiveLevel(level) {
+    if (!stage.value)
+      throw new Error('avatar stage is unavailable')
+    await stage.value.applyAvatarProactiveLevel(level)
+  },
+  isWindowVisible: () => document.visibilityState === 'visible',
+})
+
+const cleanupAvatarRendererHandler = defineInvokeHandler(
+  eventaContext.value,
+  avatarRendererInvoke,
+  request => avatarRendererRuntime.handle(request),
+)
+
+onMounted(async () => {
+  // Companion Desktop owns only the managed avatar stage. It deliberately skips
+  // AIRI chat, auth, analytics, plugins, MCP, Godot, server channel and onboarding.
+  const managedAvatar = await getManagedAvatar()
+  if (!managedAvatar)
+    throw new Error('Companion Desktop managed avatar is unavailable')
+
+  displayModelsStore.registerManagedDisplayModel({
+    id: managedAvatar.id,
+    format: DisplayModelFormat.VRM,
+    type: 'url',
+    url: managedAvatar.url,
+    name: managedAvatar.name,
+    importedAt: Number.MAX_SAFE_INTEGER,
+  })
+  settingsStore.stageModelSelected = managedAvatar.id
+  await settingsStore.initializeStageModel()
+})
+
+onUnmounted(() => cleanupAvatarRendererHandler())
+</script>
+
+<template>
+  <CompanionDesktopStage
+    ref="stage"
+    :api="companionControl"
+    :runtime="avatarRendererRuntime"
+  />
+</template>
