+import { describe, expect, it, vi } from 'vitest'
+
+import { createCompanionCloseToTrayHandler, resolveCompanionWindowProfile, shouldPersistCompanionBounds } from './companion-window'
+
+describe('companion desktop window profile', () => {
+  it('uses a resizable standard desktop window', () => {
+    expect(resolveCompanionWindowProfile(true)).toMatchObject({
+      width: 1180,
+      height: 760,
+      minWidth: 920,
+      minHeight: 640,
+      transparent: true,
+      alwaysOnTop: false,
+    })
+  })
+
+  it('preserves AIRI pet-window defaults outside desktop mode', () => {
+    expect(resolveCompanionWindowProfile(false)).toMatchObject({
+      width: 450,
+      height: 600,
+      transparent: true,
+      alwaysOnTop: true,
+    })
+  })
+
+  it('persists only standard desktop bounds', () => {
+    expect(shouldPersistCompanionBounds(true, 'standard')).toBe(true)
+    expect(shouldPersistCompanionBounds(true, 'compact')).toBe(false)
+    expect(shouldPersistCompanionBounds(false, 'compact')).toBe(true)
+  })
+
+  it('stops voice before hiding and deduplicates repeated close events', async () => {
+    let finishStopVoice: (() => void) | undefined
+    const stopVoice = vi.fn(() => new Promise<void>((resolve) => {
+      finishStopVoice = resolve
+    }))
+    const hideWindow = vi.fn()
+    const closeToTray = createCompanionCloseToTrayHandler({ stopVoice, hideWindow })
+
+    const firstClose = closeToTray()
+    const repeatedClose = closeToTray()
+
+    expect(stopVoice).toHaveBeenCalledOnce()
+    expect(hideWindow).not.toHaveBeenCalled()
+    expect(repeatedClose).toBe(firstClose)
+
+    finishStopVoice?.()
+    await firstClose
+
+    expect(hideWindow).toHaveBeenCalledOnce()
+  })
+})
