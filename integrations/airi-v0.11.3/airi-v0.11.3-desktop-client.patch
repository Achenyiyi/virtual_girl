+    destroy = vi.fn()
+    setContextMenu = vi.fn()
+    setToolTip = vi.fn()
+  },
+}))
+
+vi.mock('@electron-toolkit/utils', () => ({
+  is: { dev: false },
+}))
+
+vi.mock('@proj-airi/electron-vueuse/main', () => ({
+  isRendererUnavailable: vi.fn(() => false),
+}))
+
+vi.mock('alien-signals', () => ({
+  effect: vi.fn(),
+}))
+
+vi.mock('std-env', () => ({
+  isMacOS: false,
+}))
+
+vi.mock('../libs/bootkit/lifecycle', () => ({
+  onAppBeforeQuit: vi.fn(),
+}))
+
+vi.mock('../windows/shared/window', () => ({
+  toggleWindowShow: vi.fn(),
+}))
+
+vi.mock('../windows/shared/display', () => ({
+  computeResizedBoundsAnchoredToDominantDisplay: vi.fn(),
+  findDominantDisplayArea: vi.fn(),
+}))
+
+vi.mock('../windows/inlay', () => ({
+  setupInlayWindow: vi.fn(),
+}))
+
+describe('companion tray quit lifecycle', () => {
+  beforeEach(() => {
+    vi.resetModules()
+    vi.clearAllMocks()
+    electronState.menuTemplate = undefined
+  })
+
+  it('quits Electron only after the host accepts application.quit', async () => {
+    const request = vi.fn().mockResolvedValue({ accepted: true })
+    const { setupCompanionTray } = await import('./index')
+    setupCompanionTray({
+      mainWindow: {} as Electron.BrowserWindow,
+      companionControl: { request } as never,
+    })
+
+    const quitItem = electronState.menuTemplate?.find(item => item.label === '退出')
+    expect(quitItem?.click).toBeTypeOf('function')
+    quitItem?.click?.({} as Electron.MenuItem, {} as Electron.BrowserWindow, {} as Electron.KeyboardEvent)
+    await vi.waitFor(() => expect(request).toHaveBeenCalledWith('application.quit'))
+    expect(electronState.appQuit).toHaveBeenCalledOnce()
+  })
+
+  it('keeps Electron running when the host rejects or fails application.quit', async () => {
+    const request = vi.fn()
+      .mockResolvedValueOnce({ accepted: false })
+      .mockRejectedValueOnce(new Error('host unavailable'))
+    const { setupCompanionTray } = await import('./index')
+    setupCompanionTray({
+      mainWindow: {} as Electron.BrowserWindow,
+      companionControl: { request } as never,
+    })
+
+    const quitItem = electronState.menuTemplate?.find(item => item.label === '退出')
+    quitItem?.click?.({} as Electron.MenuItem, {} as Electron.BrowserWindow, {} as Electron.KeyboardEvent)
+    await vi.waitFor(() => expect(request).toHaveBeenCalledTimes(1))
+    expect(electronState.appQuit).not.toHaveBeenCalled()
+
+    quitItem?.click?.({} as Electron.MenuItem, {} as Electron.BrowserWindow, {} as Electron.KeyboardEvent)
+    await vi.waitFor(() => expect(request).toHaveBeenCalledTimes(2))
+    expect(electronState.appQuit).not.toHaveBeenCalled()
+  })
+})
