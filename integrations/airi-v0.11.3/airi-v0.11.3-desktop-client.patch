+  capabilities?: Record<string, boolean>
+  providers?: Record<string, string>
+  credentials?: Record<CompanionCredentialKind, string>
+  voice?: { enabled?: boolean, state?: string, device?: string }
+  emotion?: { dominant?: string, valence?: number, arousal?: number, energy?: number }
+  identity?: { name?: string }
+  session_id?: string
+  active_turn?: { turn_id?: string } | null
