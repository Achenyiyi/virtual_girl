+  exposeRestrictedElectronAPI: vi.fn((electron: Record<string, unknown>) => {
+    exposedState.electron = electron
+  }),
+}))
+
+describe('companion desktop preload capability surface', () => {
+  beforeEach(() => {
+    vi.resetModules()
+    vi.clearAllMocks()
+    processState.env.COMPANION_CONTROL_PRELOAD_ENABLED = '1'
+    exposedState.api = undefined
+    exposedState.electron = undefined
+  })
+
+  it('exposes only the fixed Control methods and restricted Eventa transport', async () => {
