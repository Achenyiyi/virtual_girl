+import { describe, expect, it } from 'vitest'
+
+import {
+  createSemanticExpressionController,
+  requireLive2DMotionStarted,
+  resolveLive2DGesture,
+} from './avatar-semantics'
+
+function coreModel(parameterIds: string[]) {
+  const values = new Map<string, number>()
+  const parameters = {
+    ids: parameterIds,
+    minimumValues: parameterIds.map(id => id === 'ParamMouthForm' ? -1 : 0),
+    maximumValues: parameterIds.map(() => 1),
+    defaultValues: parameterIds.map(() => 0),
+  }
+  return {
+    getModel: () => ({ parameters }),
+    setParameterValueById(parameterId: string, value: number) {
+      values.set(parameterId, value)
+    },
+    values,
+  }
+}
+
+describe('avatar Live2D semantics', () => {
+  it('applies synthetic happy parameters as a final per-frame override', () => {
+    const model = coreModel(['ParamEyeLSmile', 'ParamEyeRSmile', 'ParamMouthForm', 'ParamCheek'])
+    const controller = createSemanticExpressionController()
+
+    expect(controller.set(model, 'happy', 0.75, 0)).toBe(true)
+    model.values.set('ParamMouthForm', -1)
+    controller.apply(model)
+
+    expect(model.values.get('ParamEyeLSmile')).toBe(0.75)
+    expect(model.values.get('ParamEyeRSmile')).toBe(0.75)
+    expect(model.values.get('ParamMouthForm')).toBe(0.75)
+    expect(model.values.get('ParamCheek')).toBeCloseTo(0.6)
+  })
+
+  it('resets synthetic parameters when neutral is requested', () => {
+    const model = coreModel(['ParamEyeLSmile', 'ParamMouthForm'])
+    const controller = createSemanticExpressionController()
+    controller.set(model, 'happy', 1, 0)
+    controller.apply(model)
+
+    expect(controller.set(model, 'neutral', 1, 0)).toBe(true)
+    controller.apply(model)
+
+    expect(model.values.get('ParamEyeLSmile')).toBe(0)
+    expect(model.values.get('ParamMouthForm')).toBe(0)
+  })
+
+  it('fails closed when an expression has no real model parameters', () => {
+    const model = coreModel(['ParamAngleX'])
+    const controller = createSemanticExpressionController()
+
+    expect(controller.set(model, 'happy', 1, 0)).toBe(false)
+    expect(controller.set(model, 'unknown', 1, 0)).toBe(false)
+  })
+
+  it('requires a mouth-form parameter plus another visible expression parameter', () => {
+    const controller = createSemanticExpressionController()
+
+    expect(controller.set(coreModel(['ParamMouthForm']), 'happy', 1, 0)).toBe(false)
+    expect(controller.set(coreModel(['ParamBrowLY']), 'happy', 1, 0)).toBe(false)
+  })
+
+  it('an unknown expression does not cancel the active reset timer', async () => {
+    const model = coreModel(['ParamEyeLSmile', 'ParamMouthForm'])
+    const controller = createSemanticExpressionController()
+
+    expect(controller.set(model, 'happy', 1, 1)).toBe(true)
+    controller.apply(model)
+    expect(controller.set(model, 'unknown', 1, 0)).toBe(false)
+    await new Promise(resolve => setTimeout(resolve, 10))
+    controller.apply(model)
+
+    expect(model.values.get('ParamEyeLSmile')).toBe(0)
+    expect(model.values.get('ParamMouthForm')).toBe(0)
+  })
+
+  it('maps the acceptance nod to Hiyori FlickDown', () => {
+    const motion = resolveLive2DGesture('nod', [
+      { motionName: 'Idle', motionIndex: 0, fileName: 'motion/hiyori_m01.motion3.json' },
+      { motionName: 'FlickDown', motionIndex: 0, fileName: 'motion/hiyori_m04.motion3.json' },
+    ], 'preset-live2d-1')
+
+    expect(motion).toEqual({
+      motionName: 'FlickDown',
+      motionIndex: 0,
+      fileName: 'motion/hiyori_m04.motion3.json',
+    })
+  })
+
+  it('does not invent aliases for unverified Hiyori motions', () => {
+    const motions = [
+      { motionName: 'FlickUp', motionIndex: 0, fileName: 'motion/hiyori_m03.motion3.json' },
+      { motionName: 'Flick', motionIndex: 0, fileName: 'motion/hiyori_m05.motion3.json' },
+    ]
+
+    expect(resolveLive2DGesture('wave', motions, 'preset-live2d-1')).toBeUndefined()
+    expect(resolveLive2DGesture('head_tilt', motions, 'preset-live2d-1')).toBeUndefined()
+  })
+
+  it('does not reuse the Hiyori nod alias for another model or motion file', () => {
+    const hiyoriMotion = [
+      { motionName: 'FlickDown', motionIndex: 0, fileName: 'motion/hiyori_m04.motion3.json' },
+    ]
+    const otherMotion = [
+      { motionName: 'FlickDown', motionIndex: 0, fileName: 'motion/other_m04.motion3.json' },
+    ]
+
+    expect(resolveLive2DGesture('nod', hiyoriMotion, 'display-model-custom')).toBeUndefined()
+    expect(resolveLive2DGesture('nod', otherMotion, 'preset-live2d-1')).toBeUndefined()
+  })
+
+  it('rejects motion acknowledgement when the SDK reports no start', async () => {
+    await expect(requireLive2DMotionStarted(async () => false, 'FlickDown')).rejects.toThrow('did not start')
+  })
+})
